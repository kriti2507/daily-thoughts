# Copy these into .env.example (placeholders as-is) and .env (filled in).
# Delete this file afterwards — it exists only because the agent sandbox
# blocks writing any path matching .env*

# Postgres connection string — Neon, Supabase, RDS, or local.
# Supabase/PgBouncer users: the pooled connection string is fine, the client
# already sets prepare:false for transaction-mode poolers.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your personal chat id — the only chat whose messages are stored.
# Must be numeric. A non-numeric value throws on every webhook call rather
# than silently dropping messages. Find it at:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Shared secret verified on every webhook request. Generate with:
#   openssl rand -hex 32
# This must be identical to the value registered via `npm run webhook:set`.
TELEGRAM_WEBHOOK_SECRET=

# Optional. IANA time zone for displayed timestamps; defaults to UTC.
# A Vercel function's clock is UTC, so set this to your own zone or the
# times shown will be wrong. An invalid zone logs a warning and falls
# back to UTC rather than crashing the page.
DISPLAY_TIME_ZONE=UTC

ADMIN_SECRET=

TYPESAFE_API_KEY=